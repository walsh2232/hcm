# ---- Secrets & credentials (never commit) -------------------------------
*.env
.env*
!.env.example
credentials*.json
*.pem
*.key
*.p12
*.jks
wallet/

# ---- Oracle HCM extracts & data -----------------------------------------
# Real HCM data contains PII. Only templates and synthetic fixtures belong
# in the repo; anything under data/live/ is quarantined by default.
data/live/
data/**/*.dat
data/**/*.zip
!data/**/templates/*.dat
*.csv
!**/fixtures/*.csv
!**/templates/*.csv

# ---- Downloaded Oracle documentation ------------------------------------
# Oracle manuals, PDFs, extracted text, and the local retrieval index are
# fetched at runtime; do not redistribute them via this public repository.
.project/docs/oracle/**/*.pdf
.project/docs/oracle/**/*.docx
.project/docs/oracle/**/*.xlsx
.cache/oracle-hcm/
*.sqlite3
*.db

# ---- Tooling ------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
*.log
.idea/
.vscode/
